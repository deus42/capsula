# Copy to /srv/capsula/capsula.env (chmod 600). Every value without a default is required in production.
NODE_ENV=production
BETTER_AUTH_URL=https://capsula.fit
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for a private alias Google cannot register (e.g. a stage behind a private gateway): the registered callback
# on a public address of the same server, which relays the browser to BETTER_AUTH_URL, and that address's origin.
# GOOGLE_REDIRECT_URI=https://stage.example.com/api/auth/callback/google
# BETTER_AUTH_TRUSTED_ORIGINS=https://stage.example.com
OWNER_EMAIL=
# SIGNUP=open opens sign-up without an invite.
SIGNUP=invite
# Cloudflare Tunnel on the same host: rate limits use CF-Connecting-IP from it.
TRUST_PROXY=cloudflare
# AI. Without OPENAI_API_KEY the site runs on the owner's ChatGPT subscription through Codex (sign in once with
# `codex login --device-auth` inside the container, see deploy/README.md). By default only OWNER_EMAIL (and the
# owner's test accounts) can sign in and use AI, and invites are off. CODEX_ACCESS=accounts lets invited accounts use
# it too, within their monthly allowances: check your provider's terms before sharing a subscription.
# With a key, the OpenAI API serves every account.
OPENAI_API_KEY=
# CODEX_ACCESS=accounts
# With a key: model names and prices from the current official OpenAI model and price lists; there are no defaults.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_PRICES=text_in:,text_out:,image_in:,image_out:,search_call:
OPENAI_TRYON_QUALITY=high
OPENAI_PACKSHOT_QUALITY=medium
MONTHLY_BUDGET_USD=30
MAX_JOBS=2
QUOTA_TRYON=10
QUOTA_PACKSHOT=60
QUOTA_INTAKE=100
QUOTA_STYLING=30
QUOTA_ADVICE=30
QUOTA_TRYON_QUEUE=3
SUPPORT_URL=
